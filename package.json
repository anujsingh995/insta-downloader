{
  "name": "media-downloader-backend",
  "version": "1.0.0",
  "description": "Backend API for downloading public Instagram media",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "frontend": "npm --prefix frontend run dev",
    "start:all": "concurrently \"npm run dev\" \"npm run frontend\"",
    "start": "node src/server.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "youtube-dl-exec": "^3.1.15"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.4"
  }
}
