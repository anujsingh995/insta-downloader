PORT=4000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
FETCH_TIMEOUT_MS=30000
CACHE_TTL_SECONDS=300
MAX_PROXY_BYTES=104857600

# Profile mode (keep token server-side)
APIFY_API_TOKEN=PASTE_YOUR_APIFY_TOKEN_HERE
APIFY_PROFILE_ACTOR=fetch_cat~instagram-profile-posts-scraper
APIFY_MAX_POSTS=50

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=PASTE_A_STRONG_PASSWORD_HERE

# Local: ./data | Render with persistent disk: /var/data
STATS_DATA_DIR=./data

# Optional frontend build variables
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_SITE_VERIFICATION=your_verification_token
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT_HERO=1234567890
# VITE_ADSENSE_SLOT_RESULTS=1234567890
